{
  "manifest_version": 3,
  "name": "LeetCode Enforcer",
  "version": "0.1.0",
  "description": "Blocks distracting sites until you solve your daily LeetCode quota. Spaced repetition + Supabase sync.",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "tabs",
    "scripting",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content/leetcode_inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content/leetcode_content.js"],
      "css": ["content/overlay.css"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/leetcode_inject.js"],
      "matches": ["https://leetcode.com/*"]
    },
    {
      "resources": ["block/block.html", "block/block.css", "block/block.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LeetCode Enforcer"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
